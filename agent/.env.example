# Agente local do radar — copie para `.env` ou configure no ambiente.
# Nunca versione valores reais.

# Endereco do Bom Dia (producao por padrao).
BOMDIA_BASE_URL=https://bomdia.rafastos.com.br

# Token de servico cadastrado no Coolify (runtime only). Obrigatorio fora do DRY_RUN.
BOMDIA_SERVICE_TOKEN=cole-o-token-aqui

# Pasta raiz da CENTRAL observada.
CENTRAL_DIR=C:\Users\rafaa\CENTRAL\Rafael

# Ajustes finos (opcionais).
# DEBOUNCE_MS=2000
# SCAN_INTERVAL_MS=900000
# BATCH_SIZE=25
# STATE_PATH=.state.json
# DRY_RUN=1

# Bom Dia - exemplo de variaveis de ambiente.
# Copie para .env (que NAO vai pro git) OU cadastre estes valores no Coolify.
# NUNCA coloque a chave real neste arquivo de exemplo versionado.

# Ambiente: "production" na VPS, "local" (ou vazio) no seu computador.
APP_ENV=production

# Rede
HOST=0.0.0.0
PORT=9463

# Dados: pasta persistente (volume). Local pode deixar vazio (usa a pasta do projeto).
DATA_DIR=/data

# OpenAI (em producao, a chave vem daqui e nunca e gravada em disco)
OPENAI_API_KEY=sk-cole-sua-chave-aqui
OPENAI_MODEL=gpt-4.1-mini

# Cosmetico
APP_NAME=Bom Dia

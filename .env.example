# Bom Dia - exemplo de variaveis de ambiente.
# Copie para .env (que NAO vai pro git) OU cadastre estes valores no Coolify.
# NUNCA coloque a chave real neste arquivo de exemplo versionado.

# Ambiente: "production" na VPS, "local" (ou vazio) no seu computador.
APP_ENV=production

# Rede
HOST=0.0.0.0
PORT=9463

# Dados: pasta persistente (volume). Local pode deixar vazio (usa a pasta do projeto).
DATA_DIR=/data

# OpenAI (em producao, a chave vem daqui e nunca e gravada em disco)
OPENAI_API_KEY=sk-cole-sua-chave-aqui
OPENAI_MODEL=gpt-4.1-mini

# Cosmetico
APP_NAME=Bom Dia

# Acesso temporario. O app ja traz o usuario Rafastos e a senha combinada como
# padrao; defina estas variaveis para trocar sem alterar o codigo.
AUTH_USER=Rafastos
AUTH_PASSWORD=troque-por-uma-senha-forte
# Use uma string aleatoria longa. Mantendo-a fixa, as sessoes sobrevivem a redeploys.
AUTH_SECRET=gere-uma-string-aleatoria-de-pelo-menos-32-bytes

# Armazenamento de arquivos (Cloudflare R2, S3-compativel). Habilita o upload de
# anexos em tarefas e projetos. Sem estas 4 variaveis, o upload fica desativado e
# a UI some (o resto do app funciona normal). Bucket privado; o app serve os
# arquivos por proxy atras do login (nada fica publico).
#
# Na VPS/Coolify: NAO redigite os valores aqui. Use as Shared Variables (escopo
# Team) ja cadastradas, referenciando no app Bom Dia:
#   R2_ENDPOINT={{team.R2_ENDPOINT}}
#   R2_BUCKET={{team.R2_BUCKET}}
#   R2_ACCESS_KEY_ID={{team.R2_ACCESS_KEY_ID}}
#   R2_SECRET_ACCESS_KEY={{team.R2_SECRET_ACCESS_KEY}}
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=rafastos-storage
R2_ACCESS_KEY_ID=coloque-aqui-ou-referencie-a-shared-variable
R2_SECRET_ACCESS_KEY=coloque-aqui-ou-referencie-a-shared-variable  # marque como secret
# Pasta deste projeto dentro do bucket (default: bomdia) e limite de upload em MB.
R2_PREFIX=bomdia
MAX_UPLOAD_MB=25

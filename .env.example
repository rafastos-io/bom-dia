# Bom Dia v3 - exemplo de variaveis de ambiente do server (Node/Hono).
# Copie para .env local OU cadastre no Coolify. NUNCA coloque valores reais neste arquivo.

# Ambiente: "production" na VPS, "test"/"development" local.
APP_ENV=production
PORT=9463

# Login (sessao por cookie HttpOnly). AUTH_SECRET assina o token; mantenha fixo.
AUTH_USER=Rafastos
AUTH_PASSWORD=troque-por-uma-senha-forte
AUTH_SECRET=gere-uma-string-aleatoria-de-pelo-menos-32-bytes

# Token do agente local do radar (Authorization: Bearer). Sem ele, a ingestao fica 401.
SERVICE_TOKEN=gere-outra-string-aleatoria-de-pelo-menos-32-bytes

# Banco: Turso (libSQL). Sem estas duas, o server usa um arquivo local em server/data/ (dev).
TURSO_DATABASE_URL=libsql://<seu-banco>.turso.io
TURSO_AUTH_TOKEN=cole-o-token-aqui

# OpenAI (a chave de ambiente tem prioridade e nunca e gravada no banco).
OPENAI_API_KEY=sk-cole-sua-chave-aqui
OPENAI_MODEL=gpt-4.1-mini

# Anexos no Cloudflare R2 (S3-compativel). Sem as quatro, o painel de anexos some.
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=rafastos-storage
R2_ACCESS_KEY_ID=coloque-aqui
R2_SECRET_ACCESS_KEY=coloque-aqui
R2_PREFIX=bomdia
MAX_UPLOAD_MB=25

# Backup do Turso para o R2 (automatico com TURSO_* remoto + R2_* configurados).
# O servidor checa na subida e a cada 6 h; roda quando a janela venceu.
BACKUP_INTERVAL_DAYS=7
BACKUP_RETENTION=12

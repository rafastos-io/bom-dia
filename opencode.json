{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git remote add*": "deny",
      "gh pr*": "deny",
      "gh release*": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rm -rf *": "deny",
      "Remove-Item * -Recurse*": "deny"
    },
    "external_directory": {
      "*": "allow",
      "C:/Users/rafaa/VPS/**": "deny"
    }
  }
}
